{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sentinel-x/scenario.schema.json",
  "title": "SENTINEL-X training scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "version", "title", "rubric_id", "rubric_version", "difficulty_band", "learning_objectives", "allowed_response_categories", "environment", "observations"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "maxLength": 2000},
    "rubric_id": {"type": "string", "minLength": 1},
    "rubric_version": {"type": "string", "minLength": 1},
    "approval_status": {"enum": ["draft", "instructor_approved", "retired"]},
    "difficulty_band": {"enum": ["beginner", "intermediate", "advanced", "professional"]},
    "learning_objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_response_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["preset", "visibility_band"], "properties": {"preset": {"type": "string"}, "visibility_band": {"enum": ["normal", "reduced", "degraded"]}}},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "expected_category", "is_relevant"], "properties": {"observation_id": {"type": "string", "minLength": 1}, "display_prompt": {"type": "string", "maxLength": 500}, "expected_category": {"type": "string", "minLength": 1}, "is_relevant": {"type": "boolean"}}}}
  }
}
